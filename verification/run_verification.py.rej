+    step: float,
+    spin: SpinTreatment = SpinTreatment.RHF,
+    *,
+    functional: ExchangeCorrelationFunctional | None = None,
+    grid: QuadratureGrid | None = None,
 ) -> float:
     atoms = list(molecule.atoms)
     x, y, z = atoms[atom_index].position
