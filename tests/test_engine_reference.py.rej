+def test_rohf_optimization_of_an_open_shell_converges() -> None:
+    """ROHF-оптимизация открытой оболочки доходит до конца.
+
+    Раньше запрос отклонялся честной ошибкой: реестр ограничивал ROHF
+    энергией в одной точке, а аналитических градиентов не было. Теперь они
+    есть (с фокиан-зависимыми весами релаксации), и оптимизация идёт по
+    поверхности ROHF, а не по силе другого метода.
+    """
+    ch = Molecule.from_xyz(
+        (Path(__file__).parent / "fixtures" / "ch-radical.xyz").read_text(encoding="utf-8"),
+        name="ch",
+        multiplicity=2,
+    )
+    result = _run(
+        molecule=ch,
+        spec=CalculationSpec(
+            task=Task.OPTIMIZATION,
+            method=MethodSpec(theory=TheoryFamily.HF, basis="sto-3g", spin=SpinTreatment.ROHF),
+            optimization=OptimizationSpec(coordinates="cartesian"),
+        ),
+    )
+    assert result.converged
+    assert result.final_molecule is not None
+    assert result.optimization_steps is not None and result.optimization_steps > 0
+    # ROHF — собственное состояние Ŝ²: загрязнение отсутствует в точности.
+    assert result.spin_squared is not None
+    assert result.spin_squared == pytest.approx(0.75, abs=1e-10)
+
+
+def test_rohf_frequencies_run_on_the_optimized_geometry() -> None:
+    """Частоты ROHF: оптимизация → частоты на стационарной геометрии.
+
+    Полный вертикальный срез: оптимизатор считает силу по аналитическому
+    градиенту ROHF, а гессиан строится из тех же градиентов. Двухатомник даёт
+    ровно одну колебательную моду; на оптимизированной геометрии она вещественная
+    и предупреждений о нестационарности нет.
+    """
+    ch = Molecule.from_xyz(
+        (Path(__file__).parent / "fixtures" / "ch-radical.xyz").read_text(encoding="utf-8"),
+        name="ch",
+        multiplicity=2,
+    )
+    rohf = MethodSpec(theory=TheoryFamily.HF, basis="sto-3g", spin=SpinTreatment.ROHF)
+    optimized = _run(
+        molecule=ch,
+        spec=CalculationSpec(
+            task=Task.OPTIMIZATION,
+            method=rohf,
+            optimization=OptimizationSpec(coordinates="cartesian"),
+        ),
+    )
+    assert optimized.final_molecule is not None
+    result = _run(
+        molecule=optimized.final_molecule,
+        spec=CalculationSpec(task=Task.FREQUENCIES, method=rohf),
+    )
+    assert len(result.frequencies_cm1) == 1
+    # Минимум поверхности: колебательная мода вещественная (неотрицательная).
+    assert result.frequencies_cm1[0] > 0.0
+    assert result.zero_point_energy_hartree is not None
+    assert not any(
+        warning.key == "warning.frequencies_off_stationary" for warning in result.warnings
+    )
+
+
