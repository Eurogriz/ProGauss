+            since_version = __version__
+            limitations = ()
+            notes_key = "capability.note.dispersion_none"
+        elif correction in (DispersionCorrection.D3_BJ, DispersionCorrection.D3_ZERO):
+            availability = Availability.PARTIAL
+            since_version = __version__
+            limitations = (
