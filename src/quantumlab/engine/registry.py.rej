+        # обученных функционалов dftd4 v4.0.1 (включая hf). За это — PARTIAL
+        # с описанными ограничениями, а не молчаливый IMPLEMENTED (§54 ТЗ):
+        # для LDA (svwn) обученных параметров не существует, и запрос
+        # отклоняется.
+        if correction is DispersionCorrection.NONE:
