+    cov_all = _nums(cov[i : cov.index("]", i)][cov[i : cov.index("]", i)].index("[") + 1 :])
+    rcov = {int(z): float(v) for z, v in _RAW["rcov_2009_angstrom"].items()}
+    for z in ELEMENTS:
+        if abs(cov_all[z - 1] - rcov[z]) > 1e-12:
+            raise AssertionError(f"covrad(Z={z}): {cov_all[z - 1]} != {rcov[z]}")
+    vrf = (src / "src/dftd3/data/vdwrad.f90").read_text()
+    i = vrf.index("vdwrad(max_elem*(1+max_elem)/2) = aatoau * [")
+    endv = vrf.index("]", i)
+    vdw_all = _nums(vrf[i:endv][vrf[i:endv].index("[") + 1 :])
+    for p in _RAW["vdw_pairs"]:
+        z_lo, z_hi = int(p["z_lo"]), int(p["z_hi"])
+        ic = z_lo + z_hi * (z_hi - 1) // 2 - 1
+        if abs(vdw_all[ic] * AATOA_D3 - float(p["vdw_bohr"])) > 1e-9:
+            raise AssertionError(f"vdw pair ({z_lo},{z_hi}): расхождение")
+    print("verify: все значения совпадают с исходниками s-dftd3")
+
+
+def generate(out_path: Path) -> None:
+    nref = {int(z): int(v) for z, v in _RAW["nref"].items()}
+    refcn = {int(z): tuple(float(x) for x in v) for z, v in _RAW["refcn"].items()}
+    r4raw = {int(z): float(v) for z, v in _RAW["r4raw"].items()}
+    r4eff = {int(z): float(v) for z, v in _RAW["r4eff"].items()}
+    rcov2009 = {int(z): float(v) for z, v in _RAW["rcov_2009_angstrom"].items()}
+    rcovb = {int(z): float(v) for z, v in _RAW["rcov_bohr"].items()}
+    el_lines = []
+    for z in ELEMENTS:
+        el_lines.append(
+            f"    {z}: D3ElementData(\n"
+            f"        z={z}, nref={nref[z]},\n"
+            f"        refcn=({', '.join(repr(v) for v in refcn[z])},),\n"
+            f"        r4raw={r4raw[z]!r}, r4eff={r4eff[z]!r},\n"
+            f"        rcov_2009_angstrom={rcov2009[z]!r}, rcov_bohr={rcovb[z]!r},\n"
+            f"    ),\n"
+        )
+    c6_lines = []
+    for p in _RAW["c6_pairs"]:
+        vals = [float(v) for v in p["values"]]
+        c6_lines.append(f"    ({int(p['z_lo'])}, {int(p['z_hi'])}): (")
+        for k in range(0, len(vals), 4):
+            chunk = vals[k : k + 4]
+            c6_lines.append("        " + ", ".join(repr(v) for v in chunk) + ",")
+        c6_lines.append("    ),")
+    vdw_lines = [
+        f"    ({int(p['z_lo'])}, {int(p['z_hi'])}): {float(p['vdw_bohr'])!r},"
+        for p in _RAW["vdw_pairs"]
+    ]
+    bj_lines = [f"    {k!r}: {tuple(v)!r}," for k, v in sorted(BJ_PARAMS.items())]
+    zero_lines = [f"    {k!r}: {tuple(v)!r}," for k, v in sorted(ZERO_PARAMS.items())]
+    nl = chr(10)
+    content = f'''"""Данные модели D3 (CN-зависимое дисперсионное взаимодействие).
+
+ФАЙЛ ГЕНЕРИРУЕТСЯ ``tools/generate_d3_data.py`` — не править вручную.
+
+Происхождение: s-dftd3 v1.2.1 (dftd3/simple-dftd3), файлы reference.f90,
+data/r4r2.f90, data/covrad.f90, data/vdwrad.f90, param.f90; идентично сборке
+pyscf-dispersion 1.5.0 (s-dftd3 @ 86dcf336 + mctc-lib v0.4.1), с которой
+сверяются результаты. Преобразования Fortran-доступов:
+
+* ``r4eff[z] = sqrt(0.5·r4raw[z]·sqrt(z))`` (get_r4r2_val);
+* ``rcov_bohr[z] = (4/3)·rcov_2009_angstrom[z]·AATOA_D3`` (get_covalent_rad,
+  ``covalent_rad_d3``);
+* zero-затухание: ``r0 = VDW_PAIRS[(z_lo, z_hi)]``;
+* C6: номер пары ``ic = z_lo + z_hi(z_hi−1)/2`` (с 1), значения в порядке
+  a_hi (медленно) × a_lo (быстро) — Fortran-порядок таблицы.
+
+Цитирование: S. Grimme, S. Ehrlich, L. Goerigk, J. Comput. Chem. 32 (2011)
+1456; J. Mewes, S. Ehlert, S. Grimme, J. Chem. Theory Comput. 17 (2021)
+6959–6968.
+"""
+from __future__ import annotations
+
+from dataclasses import dataclass
+
+#: Преобразование Å → bohr, использованное при подготовке данных s-dftd3.
+AATOA_D3: float = {AATOA_D3!r}
+
+#: Крутизна функции подсчёта координационного числа (s-dftd3, default_kcn).
+KCN: float = {KCN!r}
+
+#: Коэффициент весовой функции (s-dftd3, wf).
+WF: float = {WF!r}
+
+#: Элементы области применения модели.
+D3_ELEMENTS: tuple[int, ...] = {tuple(ELEMENTS)!r}
+
+#: Символы элементов в том же порядке (для сообщений об ошибках).
+ELEMENT_SYMBOLS: tuple[str, ...] = {tuple(SYMBOLS[z] for z in ELEMENTS)!r}
+
+
+@dataclass(frozen=True)
+class D3ElementData:
+    """Справочные данные D3 для элемента (атомный номер ``z``)."""
+
+    z: int
+    nref: int
+    refcn: tuple[float, ...]
+    r4raw: float
+    r4eff: float
+    rcov_2009_angstrom: float
+    rcov_bohr: float
+
+
+_ELEMENTS: dict[int, D3ElementData] = {{
+{nl.join(el_lines)}
+}}
+
+
+def element_data(z: int) -> D3ElementData:
+    """Данные D3 для элемента; ``ValueError`` вне области применения."""
+    try:
+        return _ELEMENTS[z]
+    except KeyError:
+        raise ValueError(
+            f"элемент Z={{z}} вне области применения D3: {{D3_ELEMENTS}}"
+        ) from None
+
+
+#: C6-ссылочные коэффициенты по парам элементов (z_lo, z_hi), z_lo <= z_hi.
+#: Значения: индекс ``a_hi * n_lo + a_lo`` (n_lo = число справочных состояний
+#: элемента z_lo) — порядок Fortran-индексов таблицы.
+C6_PAIRS: dict[tuple[int, int], tuple[float, ...]] = {{
+{nl.join(c6_lines)}
+}}
+
+#: Парные радиусы ван-дер-Вальса, bohr (используются в zero-затухании).
+VDW_PAIRS: dict[tuple[int, int], float] = {{
+{nl.join(vdw_lines)}
+}}
+
+
+def pair_index(z_lo: int, z_hi: int) -> int:
+    """Номер пары элементов (нумерация с 1): ``z_lo + z_hi·(z_hi−1)/2``."""
+    if z_lo > z_hi:
+        z_lo, z_hi = z_hi, z_lo
+    return z_lo + z_hi * (z_hi - 1) // 2
+
+
+def nref_of(z: int) -> int:
+    """Число справочных состояний элемента."""
+    return _ELEMENTS[z].nref
+
+
+def c6_lookup(z_lo: int, z_hi: int, a_hi: int, a_lo: int) -> float:
+    """C6 для пары элементов и справочных индексов (порядок таблицы).
+
+    ``a_lo`` — индекс справочного состояния элемента ``z_lo``,
+    ``a_hi`` — элемента ``z_hi``; плоский индекс ``a_hi·nref(z_lo)+a_lo``.
+    """
+    vals = C6_PAIRS[(z_lo, z_hi)]
+    return vals[a_hi * nref_of(z_lo) + a_lo]
+
+
+def vdw_pair(z_lo: int, z_hi: int) -> float:
+    """Вандерваальсов радиус пары, bohr (zero-затухание, r0).
+
+    Аргументы можно передавать в любом порядке — пара хранится
+    по (min Z, max Z).
+    """
+    lo, hi = (z_lo, z_hi) if z_lo <= z_hi else (z_hi, z_lo)
+    return VDW_PAIRS[(lo, hi)]
+
+
+#: Параметры BJ-затухания: функционал → (s6, s8, a1, a2).
+BJ_PARAMS: dict[str, tuple[float, float, float, float]] = {{
+{nl.join(bj_lines)}
+}}
+
+#: Параметры zero-затухания: функционал → (s6, s8, rs6, rs8, alp).
+ZERO_PARAMS: dict[str, tuple[float, float, float, float, int]] = {{
+{nl.join(zero_lines)}
+}}
+'''
+    out_path.write_text(content)
+    _format_in_place(out_path)
+    print(f"сгенерировано: {out_path}")
+
+
+def _format_in_place(out_path: Path) -> None:
+    """Прогоняет сгенерированный файл через ``ruff format``, если ruff есть.
+
+    Генератор обязан выдавать код, который проходит ``make lint`` (включая
+    ``ruff format --check``). Если ruff недоступен, пропускаем и предупреждаем:
+    в dev-окружении (``pip install -e .[dev]``) он всегда установлен.
+    """
+    if shutil.which("ruff") is None and _ruff_as_module() is None:
+        print("предупреждение: ruff не найден — пропущен ruff format")
+        return
+    cmd = _ruff_command()
+    result = subprocess.run(cmd, capture_output=True, text=True, check=False)
+    if result.returncode != 0:
+        msg = f"ruff format завершился с ошибкой: {result.stderr.strip()}"
+        raise RuntimeError(msg)
+
+
+def _ruff_as_module() -> bool:
+    try:
+        import importlib.util
+
+        return importlib.util.find_spec("ruff") is not None
+    except Exception:  # noqa: BLE001 - любая ошибка интерпретируется как «нет ruff»
+        return False
+
+
+def _ruff_command() -> list[str]:
+    if shutil.which("ruff") is not None:
+        return ["ruff", "format"]
+    return [sys.executable, "-m", "ruff", "format"]
+
+
+def main() -> int:
+    ap = argparse.ArgumentParser(description="Генерация данных D3")
+    ap.add_argument(
+        "--verify-src",
+        type=Path,
+        default=None,
+        help="путь к чек-ауту s-dftd3: повторно парсить и сверять данные",
+    )
+    args = ap.parse_args()
+    if args.verify_src is not None:
+        verify_against_source(args.verify_src)
+    out = (
+        Path(__file__).resolve().parent.parent
+        / "src"
+        / "quantumlab"
+        / "engine"
+        / "dispersion_data.py"
+    )
+    generate(out)
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
